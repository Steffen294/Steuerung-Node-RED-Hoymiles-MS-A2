        "type": "function",
        "z": "5880b8565d6df53f",
        "g": "abf20652cd428f2f",
        "name": "Buffer to Float32",
        "func": "// Die Modbus-Node gibt ein Array mit zwei 16-Bit Werten zurück\nconst reg0 = msg.payload[0];\nconst reg1 = msg.payload[1];\n\n// Buffer für 4 Bytes (32-Bit) erstellen\nconst buf = Buffer.alloc(4);\n\n// Register in Buffer schreiben (Big Endian)\nbuf.writeUInt16BE(reg0, 0);\nbuf.writeUInt16BE(reg1, 2);\n\n// Als Float32 auslesen\n// Falls der Wert extrem unplausibel ist, tausche BE zu LE\nconst power = buf.readFloatBE(0);\n\nmsg.payload = parseFloat(power.toFixed(2));\nmsg.topic = \"power/total\";\n\nreturn msg;",

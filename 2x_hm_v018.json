    {
        "id": "cbb4c34e208c1e00",
        "type": "function",
        "z": "38c8c568e9d219cd",
        "g": "f7494d91c59749c8",
        "name": "Anzeige",
        "func": "function mapBatteryStatusToGerman(status) {\n    switch (status) {\n        case \"discharge\":\n            return \"Speicher 2 - Entladen\";\n        case \"standby\":\n            return \"Speicher 2 - Ruhezustand\";\n        case \"charge\":\n            return \"Speicher 2 - Laden\";\n        default:\n            return status;\n    }\n}\n\nfunction mapGermanToColor(text) {\n    switch (text) {\n        case \"Speicher 2 - Entladen\":\n            return \"red\";\n        case \"Speicher 2 - Laden\":\n            return \"green\";\n        case \"Speicher 2 - Ruhezustand\":\n            return \"orange\";\n        default:\n            return \"\";\n    }\n}\n\nfunction mapGermanToIcon(text) {\n    switch (text) {\n        case \"Speicher 2 - Laden\":\n            return \"autorenew\";\n        case \"Speicher 2 - Entladen\":\n            return \"cached\";\n        case \"Speicher 2 - Ruhezustand\":\n            return \"pause_circle_outline\";\n        default:\n            return \"\";\n    }\n}\n\nmsg.payload = msg.payload.bat_sts;\n\nconst germanStatus = mapBatteryStatusToGerman(msg.payload);\nmsg.payload2 = germanStatus;\n\nmsg.payload = mapGermanToColor(germanStatus);\nmsg.payload3 = mapGermanToIcon(germanStatus);\n\nreturn msg;",
        "outputs": 1,
